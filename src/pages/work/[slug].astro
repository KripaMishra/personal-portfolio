---
import type { CollectionEntry } from 'astro:content';
import { getEntries, render } from 'astro:content';
import StatusBadge from '../../components/StatusBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterIndexVisibleEntries, formatDate, getRelatedAdrs, getRelatedChallenges, getRoutableProjects } from '../../lib/content';
import { getProjectVisual } from '../../lib/visuals';
import { pageTitle } from '../../site';

export async function getStaticPaths() {
  const projects = await getRoutableProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const visual = getProjectVisual(project.slug);
const relatedArticles = filterIndexVisibleEntries(await getEntries(project.data.articleRefs));
const relatedAdrs = await getRelatedAdrs(project.id);
const relatedChallenges = await getRelatedChallenges(project.id);
const decisionEntries = await getEntries(project.data.decisionSlots.flatMap((slot) => (slot.adrRef ? [slot.adrRef] : [])));
const decisionEntryById = new Map(decisionEntries.map((entry) => [entry.id.replace(/\.(md|mdx)$/, ''), entry]));
---

<BaseLayout title={pageTitle(project.data.title)} description={project.data.summary}>
  <div class="page-shell">
    <section class="case-head">
      <div class="case-head__copy">
        <p class="eyebrow">Project record</p>
        <h1 class="page-title">{project.data.title}</h1>
        <p class="lead">{project.data.summary}</p>
        <div class="case-head__meta">
          <StatusBadge lifecycle={project.data.lifecycle} />
          <span class="meta">State since {formatDate(project.data.stateSince)}</span>
          <span class="meta">{project.data.techStack.join(' · ')}</span>
        </div>
      </div>
      <figure class="case-head__visual">
        <img src={visual.src} width="1200" height="760" alt={visual.alt} />
        <figcaption>{visual.caption}</figcaption>
      </figure>
    </section>

    <div class="detail-grid">
      <article class="prose">
        <p class="project-current-state"><strong>Current state.</strong> {project.data.currentState}</p>
        <Content />
      </article>

      <aside class="info-stack" aria-label="Project references">
        <section>
          <h2>Evidence</h2>
          {project.data.sourceLinks.length > 0 || project.data.liveUrl || project.data.releaseUrl ? (
            <ul class="reference-list">
              {project.data.sourceLinks.map((link) => (
                <li><a href={link.url} rel="noreferrer" target="_blank">{link.label} ↗</a></li>
              ))}
              {project.data.liveUrl && (
                <li>
                  <a href={project.data.liveUrl} rel="noreferrer" target="_blank">Open live project ↗</a>
                  {project.data.liveUrlCheckedOn && <span class="meta">Checked {formatDate(project.data.liveUrlCheckedOn)}</span>}
                </li>
              )}
              {project.data.releaseUrl && (
                <li><a href={project.data.releaseUrl} rel="noreferrer" target="_blank">{project.data.releaseLabel} ↗</a></li>
              )}
            </ul>
          ) : (
            <p class="muted">Evidence links have not been published yet.</p>
          )}
        </section>

        <section>
          <h2>Related writing</h2>
          {relatedArticles.length > 0 ? (
            <ul class="reference-list">
              {relatedArticles.map((article) => <li><a href={`/writing/${article.slug}`}>{article.data.title} →</a></li>)}
            </ul>
          ) : (
            <p class="muted">No related writing is public yet.</p>
          )}
        </section>

        <section>
          <h2>Decisions</h2>
          {project.data.decisionSlots.length > 0 || relatedAdrs.length > 0 ? (
            <div class="decision-grid">
              {project.data.decisionSlots.map((slot) => {
                const entry = slot.adrRef ? decisionEntryById.get(slot.adrRef.id.replace(/\.(md|mdx)$/, '')) : undefined;
                const href = entry ? `/work/${project.slug}/decisions/${entry.slug}` : null;
                return href ? (
                  <a class="decision-card" href={href}>
                    <span class="decision-card__state">Published ADR</span>
                    <strong>{slot.title}</strong>
                  </a>
                ) : (
                  <div class="decision-card decision-card--static">
                    <span class="decision-card__state">ADR not yet published</span>
                    <strong>{slot.title}</strong>
                  </div>
                );
              })}
              {relatedAdrs
                .filter((adr) => !project.data.decisionSlots.some((slot) => slot.adrRef?.id.replace(/\.(md|mdx)$/, '') === adr.id.replace(/\.(md|mdx)$/, '')))
                .map((adr) => (
                  <a class="decision-card" href={`/work/${project.slug}/decisions/${adr.slug}`}>
                    <span class="decision-card__state">Published ADR</span>
                    <strong>{adr.data.title}</strong>
                  </a>
                ))}
            </div>
          ) : (
            <p class="muted">No related ADRs are public yet.</p>
          )}
        </section>

        {relatedChallenges.length > 0 && (
          <section>
            <h2>Challenges</h2>
            <ul class="reference-list">
              {relatedChallenges.map((challenge) => <li><strong>{challenge.data.title}</strong><span>{challenge.data.summary}</span></li>)}
            </ul>
          </section>
        )}

        <section>
          <h2>Image note</h2>
          <p class="muted">Custom synthetic study created for this portfolio. No private product interface or user data is shown.</p>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
