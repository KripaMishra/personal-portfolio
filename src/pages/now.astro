---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPublicProjects } from '../lib/content';
import { pageTitle } from '../site';

const activeProjects = (await getPublicProjects()).filter((project) =>
  ['in-development', 'iterating'].includes(project.data.lifecycle),
);
---

<BaseLayout title={pageTitle('Now')} description="Concise now page for publicly shareable project status updates.">
  <div class="page-shell">
    <section class="route-lead">
      <div>
        <p class="eyebrow">Now</p>
        <h1 class="page-title">What is moving now.</h1>
      </div>
      <p class="lead">A concise, public-safe snapshot. Internal or unreviewed work stays off this route.</p>
    </section>

    <section class="editorial-section" aria-labelledby="active-work-heading">
      <div class="section-heading">
        <p class="eyebrow">Active work</p>
        <h2 id="active-work-heading">Current public records</h2>
      </div>
      {activeProjects.length > 0 ? (
        <div class="timeline">
          {activeProjects.map((project) => (
            <article>
              <p class="meta">{project.data.lifecycle} · since {formatDate(project.data.stateSince)}</p>
              <h3><a href={`/work/${project.slug}`}>{project.data.title}</a></h3>
              <p>{project.data.currentState}</p>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">No active public project records.</div>
      )}
    </section>
  </div>
</BaseLayout>
