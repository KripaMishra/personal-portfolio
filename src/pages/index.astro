---
import ArticleCard from '../components/ArticleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicArticles, getPublicProjects, stripMarkdownLinks } from '../lib/content';
import { getProjectVisual, heroVisual } from '../lib/visuals';
import { pageTitle } from '../site';

const projects = await getPublicProjects();
const articles = await getPublicArticles();
const projectBySlug = new Map(projects.map((project) => [project.slug, project]));
const featuredProject =
  projectBySlug.get('career-copilot') ?? projects.find((project) => project.data.featured) ?? projects[0];
const featuredVisual = featuredProject ? getProjectVisual(featuredProject.slug) : undefined;
const homepageProjects = ['mastra-pii', 'docneedle', 'ssi-sales-intelligence-agent']
  .map((slug) => projectBySlug.get(slug))
  .filter((project): project is NonNullable<typeof featuredProject> => Boolean(project));
const homepageArticles = articles.slice(0, 4);
const currentFocus = [
  'Memory and context boundaries',
  'Evaluation tied to user value',
  'Privacy-aware agent workflows',
  'Fallbacks that preserve useful outcomes',
];
---

<BaseLayout
  title={pageTitle()}
  description="Kripa Shankar Mishra builds reliable, human-centered AI products with evidence-first case studies, visible decisions, and review-safe technical writing."
>
  <div class="page-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Systems · evidence · boundaries</p>
        <h1 class="hero-title">Building what excites <mark class="hero-title__mark">me</mark>.</h1>
        <p class="lead">I design and build AI products where trust, retrieval, privacy, and durable state need to survive contact with real systems.</p>
        <div class="hero-signoff">
          <span class="meta">India · engineering portfolio · public-safe by default</span>
          <a class="text-link" href="/work">Read the work index →</a>
        </div>
      </div>

      <figure class="hero-visual">
        <a class="hero-visual-link" href="/work" aria-label="Browse all work from the process visual">
          <img
            class="hero-image"
            src={heroVisual.src}
            width="1536"
            height="1024"
            alt={heroVisual.alt}
            style={`object-position: ${heroVisual.position}`}
            fetchpriority="high"
            loading="eager"
            decoding="sync"
          />
          <span class="hero-visual__stamp">The work starts before the model: context, evidence, and the edge of the system.</span>
        </a>
        <figcaption>{heroVisual.caption} Hero crop 4:5.</figcaption>
      </figure>
    </section>

    <section class="editorial-section" aria-labelledby="selected-work-heading">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">01 / Selected work</p>
          <h2 id="selected-work-heading">Small surfaces. Serious boundaries.</h2>
        </div>
      </div>

      {featuredProject && featuredVisual && (
        <a class="featured-layout featured-link" href={`/work/${featuredProject.slug}`} aria-label={`Read ${featuredProject.data.title} case study`}>
          <figure class="featured-image">
            <img src={featuredVisual.src} width="1200" height="760" alt={featuredVisual.alt} loading="lazy" decoding="async" />
            <figcaption>{featuredVisual.caption}</figcaption>
          </figure>
          <span class="featured-copy">
            <span class="meta project-kicker">Featured case study · {featuredProject.data.lifecycle}</span>
            <span class="featured-title">{featuredProject.data.title}</span>
            <span class="lead">{featuredProject.data.summary}</span>
            <span>{stripMarkdownLinks(featuredProject.data.currentState)}</span>
            <span class="text-link">Read the case study →</span>
          </span>
        </a>
      )}

      {homepageProjects.length > 0 && (
        <div class="project-home-list" aria-label="Selected project destinations">
          {homepageProjects.map((project, index) => (
            <a class="project-row" href={`/work/${project.slug}`} aria-label={`Open ${project.data.title} project detail`}>
              <span class="meta">0{index + 2}</span>
              <h3>{project.data.title}</h3>
              <span class="project-row__summary">{project.data.summary}</span>
              <span class="row-action" aria-hidden="true">Read →</span>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="editorial-section" aria-labelledby="current-focus-heading">
      <div class="focus-grid">
        <p class="focus-statement">Reliable AI starts where the happy path ends.</p>
        <div class="section-heading">
          <p class="eyebrow">02 / Current focus</p>
          <h2 id="current-focus-heading">Patterns that make agent systems easier to trust, inspect, and improve.</h2>
          <p class="lead">The work stays centered on product and engineering moves that help people understand the boundary, the fallback, and the evidence path.</p>
          <ul class="plain-list" aria-label="Current focus areas">
            {currentFocus.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="latest-writing-heading">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">03 / Writing</p>
          <h2 id="latest-writing-heading">The note behind the decision.</h2>
        </div>
        <p class="lead">Every note came out of a real project decision, and points back to the project it was born in.</p>
      </div>

      {homepageArticles.length > 0 ? (
        <div class="writing-list" aria-label="Latest writing destinations">
          {homepageArticles.map((article) => <ArticleCard article={article} />)}
        </div>
      ) : (
        <div class="empty-state">No writing entries are published.</div>
      )}
    </section>

    <section class="editorial-section route-cta" aria-labelledby="resume-route-heading">
      <div>
        <p class="eyebrow">04 / Resume</p>
        <h2 id="resume-route-heading">A timeline, not a claim cloud.</h2>
      </div>
      <div>
        <p class="lead">Verified experience has its own route. The web timeline is the current resume format.</p>
        <p class="route-cta__links"><a class="text-link" href="/resume">Open the timeline →</a> <a href="/about">Read the portfolio framing</a></p>
      </div>
    </section>
  </div>
</BaseLayout>
