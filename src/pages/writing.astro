---
import ArticleCard from '../components/ArticleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicArticles } from '../lib/content';
import { pageTitle } from '../site';

const articles = await getPublicArticles();
const topicCounts = articles.reduce<Record<string, number>>((accumulator, article) => {
  article.data.topics.forEach((topic) => {
    accumulator[topic] = (accumulator[topic] ?? 0) + 1;
  });
  return accumulator;
}, {});
---

<BaseLayout
  title={pageTitle('Writing')}
  description="Evidence-grounded technical writing connected to public project records."
>
  <div class="page-shell">
    <section class="route-lead">
      <div>
        <p class="eyebrow">Writing index</p>
        <h1 class="page-title">Notes that return to a system.</h1>
      </div>
      <p class="lead">Each essay starts in an existing README or accepted ADR and returns to the project that made the question concrete.</p>
    </section>

    <div class="topic-rail" aria-labelledby="topics-heading">
      <h2 id="topics-heading" class="meta">Topics</h2>
      {Object.keys(topicCounts).length > 0 ? (
        <p>{Object.entries(topicCounts).map(([topic, count]) => `${topic} ${count}`).join(' · ')}</p>
      ) : (
        <p class="muted">No writing topics are published.</p>
      )}
    </div>

    <section class="editorial-section" aria-labelledby="article-list-heading">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Index</p>
          <h2 id="article-list-heading">Every claim links to a public source.</h2>
        </div>
        <p class="lead">Claims stay bounded to public project documentation and linked evidence.</p>
      </div>
      {articles.length > 0 ? (
        <div class="writing-list">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      ) : (
        <div class="empty-state">No writing entries are published.</div>
      )}
    </section>
  </div>
</BaseLayout>
