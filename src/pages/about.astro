---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageTitle, siteContact, siteLinks } from '../site';
---

<BaseLayout
  title={pageTitle('About')}
  description="I build agentic AI, retrieval, evaluation, and production ML systems."
>
  <div class="page-shell">
    <section class="route-lead">
      <div>
        <p class="eyebrow">About</p>
        <h1 class="page-title">AI systems built for real use.</h1>
      </div>
      <p class="lead">I am an AI Engineer working on agentic AI, retrieval, evaluation, and production ML systems.</p>
    </section>

    <div class="detail-grid">
      <article class="prose">
        <h2>What I build</h2>
        <p>I build AI products that use context, memory, retrieval, and evaluation to support useful decisions. My recent work includes a clinical health coach, diabetes-care systems, and agents with clear safety and privacy boundaries.</p>
        <h2>What you will find here</h2>
        <p>The Work index contains project records with current state, evidence, and published decisions. Writing explains individual engineering choices. The Resume page lists my professional experience and the systems I worked on.</p>
        <h2>Where to start</h2>
        <p><a class="text-link" href="/work">Read the project records</a> for implementation details, or <a class="text-link" href="/resume">open the resume timeline</a> for my experience in order.</p>
      </article>
      <aside class="info-stack" aria-label="Profiles and contact">
        <section>
          <h2>Profiles</h2>
          <ul class="reference-list">
            <li><a href={siteLinks.github} rel="noreferrer" target="_blank">GitHub ↗</a></li>
            <li><a href={siteLinks.linkedin} rel="noreferrer" target="_blank">LinkedIn ↗</a></li>
          </ul>
        </section>
        <section>
          <h2>Contact</h2>
          <p>{siteContact.label}</p>
          <p class="muted">Experience is on the <a href="/resume">Resume page</a>.</p>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
